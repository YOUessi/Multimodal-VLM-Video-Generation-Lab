    "base_methods": [
      "klt_fb",
      "klt_forward"
    ],
    "thresholds_px": [
      4,
      8,
      12
    ],
    "require_all_three_views": true,
    "triangulation": "least-squares intersection of three calibrated world-frame camera rays",
    "acceptance": "reproject triangulated point into all three synchronized cameras; accept only if every reprojection is in-frame and maximum residual to the corresponding RGB-only prediction is <= threshold",
    "failure": "abstain in all three views for that track/frame",
    "calibration_source": "public camera poses, intrinsics and resolutions only; no 3-D point tracks or depth clouds",
    "selection_source": "DEV only"
  },
