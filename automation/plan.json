{
  "version": "2026-11-01-batch-27",
  "enabled": true,
  "description": "Full batch27 continuation after all prior field/type contract bugs fixed. Prechecked 91 CPU tests, all 280 generated MP4 SHA hashes, 40/40 dev target-tracker correctness and all 5 input modes for 500M and 2.2B on Tang GPU. Frozen data and source; evaluate 120 new paired test scenes without test-time tuning, with cluster bootstrap.",
  "stages": [
    {
      "id": "J1_generate_280_counterfactual_video_pairs",
      "gpu": false,
      "timeout_seconds": 500,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/object_motion_counterfactual_data.py",
        "--config",
        "configs/object_motion_v1.json"
      ]
    },
    {
      "id": "J2_dev_only_query_grounded_tracker_sanity",
      "gpu": false,
      "timeout_seconds": 300,
      "max_attempts": 1,
      "requires_files": [
        "data/object_motion_counterfactual_v1/manifest.json"
      ],
      "argv": [
        "{python}",
        "experiments/target_motion_tracking.py",
        "--config",
        "configs/object_motion_v1.json"
      ]
    },
    {
      "id": "J3_validate_all_source_video_hashes_and_opposite_pairs",
      "gpu": false,
      "timeout_seconds": 450,
      "max_attempts": 1,
      "requires_files": [
        "data/object_motion_counterfactual_v1/manifest.json"
      ],
      "argv": [
        "{python}",
        "experiments/object_motion_counterfactual_eval.py",
        "audit",
        "--config",
        "configs/object_motion_v1.json"
      ]
    },
    {
      "id": "J4_2_model_5_condition_dev_execution_smoke",
      "gpu": true,
      "min_free_mib": 12000,
      "timeout_seconds": 900,
      "max_attempts": 1,
      "requires_files": [
        "models/SmolVLM2-2.2B-Instruct/model-00001-of-00002.safetensors",
        "models/SmolVLM2-2.2B-Instruct/model-00002-of-00002.safetensors"
      ],
      "argv": [
        "{python}",
        "experiments/object_motion_counterfactual_eval.py",
        "preflight",
        "--config",
        "configs/object_motion_v1.json"
      ]
    },
    {
      "id": "J5_500M_five_condition_1200_real_GPU_inferences",
      "gpu": true,
      "min_free_mib": 11000,
      "timeout_seconds": 3600,
      "max_attempts": 1,
      "requires_files": [
        "data/object_motion_counterfactual_v1/manifest.json"
      ],
      "argv": [
        "{python}",
        "experiments/object_motion_counterfactual_eval.py",
        "evaluate",
        "--model",
        "500m",
        "--config",
        "configs/object_motion_v1.json"
      ]
    },
    {
      "id": "J6_2B_five_condition_1200_real_GPU_inferences",
      "gpu": true,
      "min_free_mib": 12000,
      "timeout_seconds": 3600,
      "max_attempts": 1,
      "requires_files": [
        "outputs/object_motion_counterfactual_v1/500m.json",
        "models/SmolVLM2-2.2B-Instruct/model-00001-of-00002.safetensors",
        "models/SmolVLM2-2.2B-Instruct/model-00002-of-00002.safetensors"
      ],
      "argv": [
        "{python}",
        "experiments/object_motion_counterfactual_eval.py",
        "evaluate",
        "--model",
        "2b",
        "--config",
        "configs/object_motion_v1.json"
      ]
    },
    {
      "id": "J7_clustered_paired_counterfactual_report_with_CV_baseline",
      "gpu": false,
      "timeout_seconds": 600,
      "max_attempts": 1,
      "requires_files": [
        "outputs/object_motion_counterfactual_v1/500m.json",
        "outputs/object_motion_counterfactual_v1/2b.json"
      ],
      "argv": [
        "{python}",
        "experiments/object_motion_counterfactual_eval.py",
        "report",
        "--config",
        "configs/object_motion_v1.json"
      ]
    },
    {
      "id": "J8_full_source_regression_tests",
      "gpu": false,
      "timeout_seconds": 300,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests"
      ]
    },
    {
      "id": "J9_no_models_video_media_committed_security",
      "gpu": false,
      "timeout_seconds": 120,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/source_security_guard.py"
      ]
    }
  ]
}
