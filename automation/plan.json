{
  "version": "2026-10-31-batch-18",
  "enabled": true,
  "description": "Resume retrospective SHA + strict perceptual connected-component STAR LoRA after canonical JSON edge serialization fix; previously frozen manifest SHA and split unchanged; new 2-seed training, validation selection, test and explicit retrospective report.",
  "stages": [
    {
      "id": "B83_verify_existing_frozen_SHA_and_perceptual_components",
      "gpu": false,
      "timeout_seconds": 900,
      "max_attempts": 1,
      "requires_files": [
        "outputs/star_perceptual_grouped_sft_v1/manifest.json"
      ],
      "argv": [
        "{python}",
        "experiments/star_perceptual_grouped_sft.py",
        "prepare",
        "--config",
        "configs/star_perceptual_grouped_v1.json"
      ]
    },
    {
      "id": "B84_fresh_perceptual_connected_train_two_seeds",
      "gpu": true,
      "min_free_mib": 11000,
      "timeout_seconds": 3600,
      "max_attempts": 1,
      "requires_files": [
        "outputs/star_perceptual_grouped_sft_v1/manifest.json"
      ],
      "argv": [
        "{python}",
        "experiments/star_perceptual_grouped_sft.py",
        "train",
        "--config",
        "configs/star_perceptual_grouped_v1.json"
      ]
    },
    {
      "id": "B85_select_model_by_validation_only",
      "gpu": true,
      "min_free_mib": 11000,
      "timeout_seconds": 2100,
      "max_attempts": 1,
      "requires_files": [
        "outputs/star_perceptual_grouped_sft_v1/adapter_19/adapter_model.safetensors",
        "outputs/star_perceptual_grouped_sft_v1/adapter_37/adapter_model.safetensors"
      ],
      "argv": [
        "{python}",
        "experiments/star_perceptual_grouped_sft.py",
        "validate",
        "--config",
        "configs/star_perceptual_grouped_v1.json"
      ]
    },
    {
      "id": "B86_one_retrospective_test_after_grouping",
      "gpu": true,
      "min_free_mib": 11000,
      "timeout_seconds": 2400,
      "max_attempts": 1,
      "requires_files": [
        "outputs/star_perceptual_grouped_sft_v1/chosen_seed.json"
      ],
      "argv": [
        "{python}",
        "experiments/star_perceptual_grouped_sft.py",
        "test",
        "--config",
        "configs/star_perceptual_grouped_v1.json"
      ]
    },
    {
      "id": "B87_explicit_retrospective_integrity_report",
      "gpu": false,
      "timeout_seconds": 180,
      "max_attempts": 1,
      "requires_files": [
        "outputs/star_perceptual_grouped_sft_v1/test_comparison.json"
      ],
      "argv": [
        "{python}",
        "experiments/star_perceptual_report.py"
      ]
    },
    {
      "id": "B88_complete_source_regression_tests",
      "gpu": false,
      "timeout_seconds": 240,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests"
      ]
    }
  ]
}
