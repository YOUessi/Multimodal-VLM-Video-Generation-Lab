{
  "version": "2026-11-01-batch-29",
  "enabled": true,
  "description": "Untuned external domain transfer check: unchanged query-grounded RGB pixel tracker on ALL 200 previously inspected public CLEVRER Moving Direction examples. Count every unsupported color and tracking failure as abstention, use predeclared strong-motion gate >=20px per axis and frozen 500M/2.2B 3/5-frame predictions for fallback. No extra GPU, no selection/tuning on these scored labels.",
  "stages": [
    {
      "id": "L1_full200_CLEVRER_untuned_tracking_and_frozen_VLM_gating",
      "gpu": false,
      "timeout_seconds": 1500,
      "max_attempts": 1,
      "requires_files": [
        "outputs/capacity_temporal_v1/manifest.json",
        "outputs/capacity_temporal_v1/500m.json",
        "outputs/capacity_temporal_v1/2b.json",
        "data/mvbench_moving_direction/text/moving_direction.json"
      ],
      "argv": [
        "{python}",
        "experiments/clevrer_untuned_tracker_transfer.py",
        "--config",
        "configs/clevrer_untuned_tracker_v1.json"
      ]
    },
    {
      "id": "L2_complete_source_regression_tests",
      "gpu": false,
      "timeout_seconds": 300,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests"
      ]
    },
    {
      "id": "L3_source_guard",
      "gpu": false,
      "timeout_seconds": 120,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/source_security_guard.py"
      ]
    }
  ]
}
