{
  "version": "2026-10-31-batch-2",
  "enabled": true,
  "description": "No-crop 1/3/5 frame baseline, real LoRA, frozen heldout comparison, Wan full-weight preflight, safe safetensors-only ZeroScope video generation",
  "stages": [
    {
      "id": "B1_temporal_baseline",
      "gpu": true,
      "min_free_mib": 11000,
      "timeout_seconds": 1200,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/temporal_batch.py",
        "baseline",
        "--config",
        "configs/round2.json"
      ]
    },
    {
      "id": "B2_lora_training",
      "gpu": true,
      "min_free_mib": 11000,
      "timeout_seconds": 1800,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/temporal_batch.py",
        "train",
        "--config",
        "configs/round2.json"
      ]
    },
    {
      "id": "B3_heldout_comparison",
      "gpu": true,
      "min_free_mib": 11000,
      "timeout_seconds": 1800,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/temporal_batch.py",
        "report",
        "--config",
        "configs/round2.json"
      ]
    },
    {
      "id": "B4_wan_feasibility",
      "gpu": false,
      "timeout_seconds": 180,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/wan_preflight.py",
        "--config",
        "configs/round2.json"
      ]
    },
    {
      "id": "B5_zeroscope_diffusion_video",
      "gpu": true,
      "min_free_mib": 11000,
      "timeout_seconds": 3000,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/zeroscope_generate.py",
        "--model",
        "models/zeroscope_v2_576w_safe",
        "--steps",
        "14",
        "--frames",
        "12"
      ]
    }
  ]
}
