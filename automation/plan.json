{
  "version": "2026-10-31-batch-3",
  "enabled": true,
  "description": "Real annotated video evaluation-only, synthetic LoRA generalization probe, multi-seed synthetic replication, Diffusion integrity+blind review, consolidated report",
  "stages": [
    {
      "id": "B6_real_video_base",
      "gpu": true,
      "min_free_mib": 11000,
      "timeout_seconds": 1800,
      "max_attempts": 1,
      "requires_files": [
        "data/mvbench_public/text/action_antonym.json",
        "data/mvbench_public/dataset_provenance.json",
        "models/SmolVLM2-500M-Video-Instruct/model.safetensors"
      ],
      "argv": [
        "{python}",
        "experiments/mvbench_real_eval.py",
        "base",
        "--config",
        "configs/mvbench_round1.json"
      ]
    },
    {
      "id": "B7_real_video_transfer",
      "gpu": true,
      "min_free_mib": 11000,
      "timeout_seconds": 1800,
      "max_attempts": 1,
      "requires_files": [
        "outputs/mvbench_round1/base.json",
        "outputs/temporal_round2/adapter/adapter_model.safetensors"
      ],
      "argv": [
        "{python}",
        "experiments/mvbench_real_eval.py",
        "synthetic_lora",
        "--config",
        "configs/mvbench_round1.json"
      ]
    },
    {
      "id": "B8_paired_real_video_report",
      "gpu": false,
      "timeout_seconds": 180,
      "max_attempts": 1,
      "requires_files": [
        "outputs/mvbench_round1/base.json",
        "outputs/mvbench_round1/synthetic_lora.json"
      ],
      "argv": [
        "{python}",
        "experiments/mvbench_real_eval.py",
        "compare",
        "--config",
        "configs/mvbench_round1.json"
      ]
    },
    {
      "id": "B9_multi_seed_synthetic_replication",
      "gpu": true,
      "min_free_mib": 11000,
      "timeout_seconds": 2200,
      "max_attempts": 1,
      "requires_files": [
        "outputs/temporal_round2/baseline.json"
      ],
      "argv": [
        "{python}",
        "experiments/multi_seed_round.py",
        "run"
      ]
    },
    {
      "id": "B10_video_generation_review",
      "gpu": false,
      "timeout_seconds": 180,
      "max_attempts": 1,
      "requires_files": [
        "outputs/diffusion_round1/generation_report.json"
      ],
      "argv": [
        "{python}",
        "experiments/generation_review.py",
        "prepare"
      ]
    },
    {
      "id": "B11_consolidated_project_report",
      "gpu": false,
      "timeout_seconds": 180,
      "max_attempts": 1,
      "requires_files": [
        "outputs/mvbench_round1/comparison.json",
        "outputs/multi_seed/REPLICATION.json",
        "outputs/diffusion_round1/generation_report.json"
      ],
      "argv": [
        "{python}",
        "experiments/project_report.py",
        "build"
      ]
    },
    {
      "id": "B12_full_code_tests",
      "gpu": false,
      "timeout_seconds": 180,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests"
      ]
    }
  ]
}
