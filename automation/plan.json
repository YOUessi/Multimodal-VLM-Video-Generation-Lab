      "timeout_seconds": 200,
      "max_attempts": 1,
      "requires_files": [
        "data/object_motion_counterfactual_v1/manifest.json"
      ],
      "argv": [
        "{python}",
        "experiments/appearance_hsv_tracker.py",
        "--config",
        "configs/appearance_hsv_transfer_v1.json"
      ]
    },
    {
      "id": "M2_all200_untuned_HSV_CLEVRER_transfer_and_frozen_gated_VLM",
      "gpu": false,
      "timeout_seconds": 1500,
      "max_attempts": 1,
      "requires_files": [
        "outputs/capacity_temporal_v1/manifest.json",
        "outputs/capacity_temporal_v1/2b.json",
        "outputs/capacity_temporal_v1/500m.json"
      ],
      "argv": [
        "{python}",
        "experiments/appearance_hsv_transfer.py",
        "--config",
        "configs/appearance_hsv_transfer_v1.json"
      ]
    },
    {
      "id": "M3_full_source_regression_suite",
      "gpu": false,
      "timeout_seconds": 300,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests"
      ]
    },
    {
      "id": "M4_no_weight_or_private_video_commit_guard",
      "gpu": false,
      "timeout_seconds": 120,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/source_security_guard.py"
      ]
    }
  ]
}
