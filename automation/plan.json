      "gpu": true,
      "timeout_seconds": 7200,
      "max_attempts": 1,
      "argv": [
        "env",
        "MVVG_VLM_MODEL=../models/SmolVLM2-500M-Video-Instruct",
        "{python}",
        "experiments/robotap_batch41_vlm.py",
        "predict-dev",
        "--config",
        "configs/robotap_batch41e.json"
      ],
      "requires_files": [
        "../models/SmolVLM2-500M-Video-Instruct/model.safetensors",
        "data/robotap_batch41/batch41_grouped_frozen/queries-public.json"
      ],
