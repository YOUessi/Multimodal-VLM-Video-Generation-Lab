{
  "version": "2026-10-31-batch-13",
  "enabled": true,
  "description": "Post SHA-grouped STAR SFT cross-task external validation on 200 official MVBench scene_transition clips, full-byte SHA overlap exclusion, no external training/model selection, 3/5-frame base vs grouped LoRA paired CIs.",
  "stages": [
    {
      "id": "B61_scene_external_200_video_preflight_and_hash_audit",
      "gpu": false,
      "timeout_seconds": 1500,
      "max_attempts": 1,
      "requires_files": [
        "outputs/star_grouped_sft_v1/AUTHORITATIVE_RESULTS.json",
        "data/mvbench_scene_transition/provenance.json",
        "data/mvbench_scene_transition/text/scene_transition.json"
      ],
      "argv": [
        "{python}",
        "experiments/mvbench_scene_external.py",
        "prepare",
        "--config",
        "configs/mvbench_scene_external_v1.json"
      ]
    },
    {
      "id": "B62_scene_external_base_3and5_inference",
      "gpu": true,
      "min_free_mib": 11000,
      "timeout_seconds": 3600,
      "max_attempts": 1,
      "requires_files": [
        "outputs/mvbench_scene_external_v1/manifest.json",
        "models/SmolVLM2-500M-Video-Instruct/model.safetensors"
      ],
      "argv": [
        "{python}",
        "experiments/mvbench_scene_external.py",
        "base",
        "--config",
        "configs/mvbench_scene_external_v1.json"
      ]
    },
    {
      "id": "B63_scene_external_SHA_grouped_adapter_3and5",
      "gpu": true,
      "min_free_mib": 11000,
      "timeout_seconds": 3600,
      "max_attempts": 1,
      "requires_files": [
        "outputs/mvbench_scene_external_v1/base.json",
        "outputs/star_grouped_sft_v1/chosen_seed.json"
      ],
      "argv": [
        "{python}",
        "experiments/mvbench_scene_external.py",
        "grouped_lora",
        "--config",
        "configs/mvbench_scene_external_v1.json"
      ]
    },
    {
      "id": "B64_external_paired_cross_task_report",
      "gpu": false,
      "timeout_seconds": 180,
      "max_attempts": 1,
      "requires_files": [
        "outputs/mvbench_scene_external_v1/grouped_lora.json",
        "outputs/mvbench_scene_external_v1/base.json"
      ],
      "argv": [
        "{python}",
        "experiments/mvbench_scene_external.py",
        "compare",
        "--config",
        "configs/mvbench_scene_external_v1.json"
      ]
    },
    {
      "id": "B65_full_github_source_tests",
      "gpu": false,
      "timeout_seconds": 240,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests"
      ]
    }
  ]
}
