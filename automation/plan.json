    {
      "id": "R09_TEST_CPU_labelblind_predictions",
      "gpu": false,
      "timeout_seconds": 7200,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/robotap_batch41_eval.py",
        "predict-test",
        "--config",
        "configs/robotap_batch41e.json"
      ],
      "requires_files": [
        "outputs/robotap_batch41e_grouped/dev_selection.json.sha256"
      ]
    },
    {
      "id": "R10_TEST_GPU_SmolVLM2_visibility_predictions_or_gate_skip",
      "gpu": true,
      "timeout_seconds": 7200,
      "max_attempts": 1,
      "argv": [
        "env",
        "MVVG_VLM_MODEL=../models/SmolVLM2-500M-Video-Instruct",
        "{python}",
        "experiments/robotap_batch41_vlm.py",
        "predict-test",
        "--config",
        "configs/robotap_batch41e.json"
      ],
      "requires_files": [
        "outputs/robotap_batch41e_grouped/vlm_visibility_dev_gate.json.sha256",
        "outputs/robotap_batch41e_grouped/test_predictions.json.sha256"
      ],
      "min_free_mib": 10000
    },
    {
      "id": "R11_first_only_TEST_CPU_private_oracle_score",
      "gpu": false,
      "timeout_seconds": 2400,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/robotap_batch41_eval.py",
        "score-test",
        "--config",
        "configs/robotap_batch41e.json"
      ],
      "requires_files": [
        "outputs/robotap_batch41e_grouped/test_predictions.json.sha256"
