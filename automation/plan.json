{
  "version": "2026-11-01-batch-25",
  "enabled": true,
  "description": "Batch25 reruns all frozen counterfactual motion experiments after tuple-to-mutable-list video generator fix. The failed batch24 produced zero video files; source changes are limited to direction shuffle and a full-data generator regression test. New Tang source freeze, no blind retry.",
  "stages": [
    {
      "id": "H1_generate_280_counterfactual_video_pairs",
      "gpu": false,
      "timeout_seconds": 500,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/object_motion_counterfactual_data.py",
        "--config",
        "configs/object_motion_v1.json"
      ]
    },
    {
      "id": "H2_dev_only_query_grounded_tracker_sanity",
      "gpu": false,
      "timeout_seconds": 300,
      "max_attempts": 1,
      "requires_files": [
        "data/object_motion_counterfactual_v1/manifest.json"
      ],
      "argv": [
        "{python}",
        "experiments/target_motion_tracking.py",
        "--config",
        "configs/object_motion_v1.json"
      ]
    },
    {
      "id": "H3_validate_all_source_video_hashes_and_opposite_pairs",
      "gpu": false,
      "timeout_seconds": 450,
      "max_attempts": 1,
      "requires_files": [
        "data/object_motion_counterfactual_v1/manifest.json"
      ],
      "argv": [
        "{python}",
        "experiments/object_motion_counterfactual_eval.py",
        "audit",
        "--config",
        "configs/object_motion_v1.json"
      ]
    },
    {
      "id": "H4_2_model_5_condition_dev_execution_smoke",
      "gpu": true,
      "min_free_mib": 12000,
      "timeout_seconds": 900,
      "max_attempts": 1,
      "requires_files": [
        "models/SmolVLM2-2.2B-Instruct/model-00001-of-00002.safetensors",
        "models/SmolVLM2-2.2B-Instruct/model-00002-of-00002.safetensors"
      ],
      "argv": [
        "{python}",
        "experiments/object_motion_counterfactual_eval.py",
        "preflight",
        "--config",
        "configs/object_motion_v1.json"
      ]
    },
    {
      "id": "H5_500M_five_condition_1200_real_GPU_inferences",
      "gpu": true,
      "min_free_mib": 11000,
      "timeout_seconds": 3600,
      "max_attempts": 1,
      "requires_files": [
        "data/object_motion_counterfactual_v1/manifest.json"
      ],
      "argv": [
        "{python}",
        "experiments/object_motion_counterfactual_eval.py",
        "evaluate",
        "--model",
        "500m",
        "--config",
        "configs/object_motion_v1.json"
      ]
    },
    {
      "id": "H6_2B_five_condition_1200_real_GPU_inferences",
      "gpu": true,
      "min_free_mib": 12000,
      "timeout_seconds": 3600,
      "max_attempts": 1,
      "requires_files": [
        "outputs/object_motion_counterfactual_v1/500m.json",
        "models/SmolVLM2-2.2B-Instruct/model-00001-of-00002.safetensors",
        "models/SmolVLM2-2.2B-Instruct/model-00002-of-00002.safetensors"
      ],
      "argv": [
        "{python}",
        "experiments/object_motion_counterfactual_eval.py",
        "evaluate",
        "--model",
        "2b",
        "--config",
        "configs/object_motion_v1.json"
      ]
    },
    {
      "id": "H7_clustered_paired_counterfactual_report_with_CV_baseline",
      "gpu": false,
      "timeout_seconds": 600,
      "max_attempts": 1,
      "requires_files": [
        "outputs/object_motion_counterfactual_v1/500m.json",
        "outputs/object_motion_counterfactual_v1/2b.json"
      ],
      "argv": [
        "{python}",
        "experiments/object_motion_counterfactual_eval.py",
        "report",
        "--config",
        "configs/object_motion_v1.json"
      ]
    },
    {
      "id": "H8_full_source_regression_tests",
      "gpu": false,
      "timeout_seconds": 300,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests"
      ]
    },
    {
      "id": "H9_no_models_video_media_committed_security",
      "gpu": false,
      "timeout_seconds": 120,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/source_security_guard.py"
      ]
    }
  ]
}
