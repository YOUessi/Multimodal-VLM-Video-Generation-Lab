{
  "version": "2026-10-31-batch-7",
  "enabled": true,
  "description": "First label-blind adaptive temporal frame sampler experiment: real STAR frozen 40-video test. Same 3/5 frame budget, base and validation-selected LoRA, paired CI, fail-closed.",
  "stages": [
    {
      "id": "B30_labelblind_frame_selection",
      "gpu": false,
      "timeout_seconds": 900,
      "max_attempts": 1,
      "requires_files": [
        "outputs/star_sft_round2/manifest.json",
        "outputs/star_sft_round2/chosen_seed.json"
      ],
      "argv": [
        "{python}",
        "experiments/adaptive_temporal_sampling.py",
        "prepare",
        "--config",
        "configs/adaptive_sampling_v1.json"
      ]
    },
    {
      "id": "B31_adaptive_base_inference",
      "gpu": true,
      "min_free_mib": 11000,
      "timeout_seconds": 1800,
      "max_attempts": 1,
      "requires_files": [
        "outputs/adaptive_sampling_v1/sampling_plan.json",
        "outputs/star_sft_round2/test_base.json"
      ],
      "argv": [
        "{python}",
        "experiments/adaptive_temporal_sampling.py",
        "base",
        "--config",
        "configs/adaptive_sampling_v1.json"
      ]
    },
    {
      "id": "B32_adaptive_lora_inference",
      "gpu": true,
      "min_free_mib": 11000,
      "timeout_seconds": 1800,
      "max_attempts": 1,
      "requires_files": [
        "outputs/adaptive_sampling_v1/base.json",
        "outputs/star_sft_round2/adapter_37/adapter_model.safetensors"
      ],
      "argv": [
        "{python}",
        "experiments/adaptive_temporal_sampling.py",
        "selected_lora",
        "--config",
        "configs/adaptive_sampling_v1.json"
      ]
    },
    {
      "id": "B33_paired_adaptive_ablation",
      "gpu": false,
      "timeout_seconds": 180,
      "max_attempts": 1,
      "requires_files": [
        "outputs/adaptive_sampling_v1/selected_lora.json",
        "outputs/adaptive_sampling_v1/base.json"
      ],
      "argv": [
        "{python}",
        "experiments/adaptive_temporal_sampling.py",
        "compare",
        "--config",
        "configs/adaptive_sampling_v1.json"
      ]
    },
    {
      "id": "B34_release_tests",
      "gpu": false,
      "timeout_seconds": 180,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests"
      ]
    }
  ]
}
