{
  "version": "2026-10-31-batch-9",
  "enabled": true,
  "description": "Resume frozen 40 real STAR video adaptive sampling after independent correctness fixes; reuse immutable existing label-blind sample plan, no new labels or test-time tuning.",
  "stages": [
    {
      "id": "B40_verify_frozen_40_video_sampling_plan",
      "gpu": false,
      "timeout_seconds": 120,
      "max_attempts": 1,
      "requires_files": [
        "outputs/adaptive_sampling_v2/sampling_plan.json",
        "outputs/star_sft_round2/manifest.json"
      ],
      "argv": [
        "{python}",
        "experiments/verify_adaptive_plan.py",
        "--config",
        "configs/adaptive_sampling_v2.json"
      ]
    },
    {
      "id": "B41_base_adaptive_3and5_frames",
      "gpu": true,
      "min_free_mib": 11000,
      "timeout_seconds": 1800,
      "max_attempts": 1,
      "requires_files": [
        "outputs/adaptive_sampling_v2/sampling_plan.json",
        "outputs/star_sft_round2/test_base.json"
      ],
      "argv": [
        "{python}",
        "experiments/adaptive_temporal_sampling.py",
        "base",
        "--config",
        "configs/adaptive_sampling_v2.json"
      ]
    },
    {
      "id": "B42_real_video_lora_adaptive_3and5",
      "gpu": true,
      "min_free_mib": 11000,
      "timeout_seconds": 1800,
      "max_attempts": 1,
      "requires_files": [
        "outputs/adaptive_sampling_v2/base.json",
        "outputs/star_sft_round2/adapter_37/adapter_model.safetensors"
      ],
      "argv": [
        "{python}",
        "experiments/adaptive_temporal_sampling.py",
        "selected_lora",
        "--config",
        "configs/adaptive_sampling_v2.json"
      ]
    },
    {
      "id": "B43_paired_adaptive_vs_uniform_40_test",
      "gpu": false,
      "timeout_seconds": 120,
      "max_attempts": 1,
      "requires_files": [
        "outputs/adaptive_sampling_v2/base.json",
        "outputs/adaptive_sampling_v2/selected_lora.json"
      ],
      "argv": [
        "{python}",
        "experiments/adaptive_temporal_sampling.py",
        "compare",
        "--config",
        "configs/adaptive_sampling_v2.json"
      ]
    },
    {
      "id": "B44_offline_regression_tests",
      "gpu": false,
      "timeout_seconds": 180,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests"
      ]
    }
  ]
}
