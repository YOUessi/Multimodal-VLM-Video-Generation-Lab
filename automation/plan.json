        "--config",
        "configs/davis_occlusion_v2.json"
      ]
    },
    {
      "id": "V3_165plus_regressions_and_future_label_firewall",
      "gpu": false,
      "timeout_seconds": 1800,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests"
      ]
    },
    {
