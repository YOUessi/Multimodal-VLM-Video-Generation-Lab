{
  "version": "2026-11-01-batch-21",
  "enabled": true,
  "description": "Fix confirmed Diffusers 0.37.1 3D UNet gradient_checkpointing unsupported exception. Same 12/4 paired synthetic video-caption manifest, new output dir and fresh CPU features, actual 12-step LoRA optimizer, matched pretrained/tuned local video generation, MSE and blind review, fail-closed.",
  "stages": [
    {
      "id": "D0_verify_frozen_video_caption_pair_manifest",
      "gpu": false,
      "timeout_seconds": 180,
      "max_attempts": 1,
      "requires_files": [
        "data/zeroscope_paired_motion_v1/manifest.json"
      ],
      "argv": [
        "{python}",
        "experiments/diffusion_paired_motion_data.py",
        "--config",
        "configs/zeroscope_lora_smoke_nockpt.json"
      ]
    },
    {
      "id": "D1_cpu_precompute_frozen_VAE_CLIP_features",
      "gpu": false,
      "timeout_seconds": 1200,
      "max_attempts": 1,
      "requires_files": [
        "models/zeroscope_v2_576w_safe/vae/diffusion_pytorch_model.safetensors"
      ],
      "argv": [
        "{python}",
        "experiments/zeroscope_video_lora.py",
        "cache",
        "--config",
        "configs/zeroscope_lora_smoke_nockpt.json"
      ]
    },
    {
      "id": "D2_actual_GPU_3D_UNet_Peft_LoRA_training",
      "gpu": true,
      "min_free_mib": 12000,
      "timeout_seconds": 1800,
      "max_attempts": 1,
      "requires_files": [
        "outputs/zeroscope_video_lora_v2/feature_cache_manifest.json",
        "models/zeroscope_v2_576w_safe/unet/diffusion_pytorch_model.safetensors"
      ],
      "argv": [
        "{python}",
        "experiments/zeroscope_video_lora.py",
        "train",
        "--config",
        "configs/zeroscope_lora_smoke_nockpt.json"
      ]
    },
    {
      "id": "D3_matched_pretrained_and_LoRA_video_inference",
      "gpu": true,
      "min_free_mib": 12000,
      "timeout_seconds": 1800,
      "max_attempts": 1,
      "requires_files": [
        "outputs/zeroscope_video_lora_v2/adapter/adapter_model.safetensors",
        "outputs/zeroscope_video_lora_v2/training_report.json"
      ],
      "argv": [
        "{python}",
        "experiments/zeroscope_lora_generate.py",
        "--config",
        "configs/zeroscope_lora_smoke_nockpt.json"
      ]
    },
    {
      "id": "D4_anonymous_independent_video_review_and_results",
      "gpu": false,
      "timeout_seconds": 180,
      "max_attempts": 1,
      "requires_files": [
        "outputs/zeroscope_video_lora_v2/generated_comparison/generation_report.json"
      ],
      "argv": [
        "{python}",
        "experiments/zeroscope_lora_report.py",
        "--config",
        "configs/zeroscope_lora_smoke_nockpt.json"
      ]
    },
    {
      "id": "D5_all_regression_tests",
      "gpu": false,
      "timeout_seconds": 240,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests"
      ]
    },
    {
      "id": "D6_publication_security_gate",
      "gpu": false,
      "timeout_seconds": 120,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/source_security_guard.py"
      ]
    }
  ]
}
