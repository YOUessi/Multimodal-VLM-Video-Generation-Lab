{
  "version": "2026-10-31-batch-5",
  "enabled": true,
  "description": "Real-video LoRA on 200 unique STAR action_sequence clips, freeze 120/40/40 source-video-disjoint split, train 2 seeds, validation-only seed selection, heldout natural-video test, complete research report",
  "stages": [
    {
      "id": "B18_star_video_split_preflight",
      "gpu": false,
      "timeout_seconds": 240,
      "max_attempts": 1,
      "requires_files": [
        "data/mvbench_star/provenance.json",
        "data/mvbench_star/text/action_sequence.json",
        "models/SmolVLM2-500M-Video-Instruct/model.safetensors"
      ],
      "argv": [
        "{python}",
        "experiments/star_real_sft.py",
        "prepare",
        "--config",
        "configs/star_real_sft_round1.json"
      ]
    },
    {
      "id": "B19_star_real_video_two_seed_lora",
      "gpu": true,
      "min_free_mib": 11000,
      "timeout_seconds": 3600,
      "max_attempts": 1,
      "requires_files": [
        "outputs/star_sft_round1/manifest.json"
      ],
      "argv": [
        "{python}",
        "experiments/star_real_sft.py",
        "train",
        "--config",
        "configs/star_real_sft_round1.json"
      ]
    },
    {
      "id": "B20_validation_only_seed_selection",
      "gpu": true,
      "min_free_mib": 11000,
      "timeout_seconds": 2400,
      "max_attempts": 1,
      "requires_files": [
        "outputs/star_sft_round1/adapter_19/adapter_model.safetensors",
        "outputs/star_sft_round1/adapter_37/adapter_model.safetensors"
      ],
      "argv": [
        "{python}",
        "experiments/star_real_sft.py",
        "validate",
        "--config",
        "configs/star_real_sft_round1.json"
      ]
    },
    {
      "id": "B21_heldout_real_action_sequence_test",
      "gpu": true,
      "min_free_mib": 11000,
      "timeout_seconds": 2400,
      "max_attempts": 1,
      "requires_files": [
        "outputs/star_sft_round1/chosen_seed.json"
      ],
      "argv": [
        "{python}",
        "experiments/star_real_sft.py",
        "test",
        "--config",
        "configs/star_real_sft_round1.json"
      ]
    },
    {
      "id": "B22_research_evidence_report_v3",
      "gpu": false,
      "timeout_seconds": 240,
      "max_attempts": 1,
      "requires_files": [
        "outputs/star_sft_round1/test_comparison.json",
        "outputs/mvbench_round1/rescored_v2/comparison_scored.json",
        "outputs/choice_bias_round1/comparison.json"
      ],
      "argv": [
        "{python}",
        "experiments/master_report_v3.py"
      ]
    },
    {
      "id": "B23_all_source_tests",
      "gpu": false,
      "timeout_seconds": 240,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests"
      ]
    }
  ]
}
