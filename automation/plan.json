{
  "version": "2026-11-01-batch-22",
  "enabled": true,
  "description": "Posthoc mechanistic diagnostic of video temporal evidence without training or test-driven prompting. Strong SmolVLM2-2.2B on the same frozen 400 video tasks: repeat middle frame with N=3/5 and reverse the original N frames. Keep original gold only for repeated static frames; never score reversed frames against original gold. Paired bootstrap CIs and choice-change rates.",
  "stages": [
    {
      "id": "E1_frozen_400_video_temporal_control_protocol_audit",
      "gpu": false,
      "timeout_seconds": 180,
      "max_attempts": 1,
      "requires_files": [
        "outputs/capacity_temporal_v1/manifest.json",
        "outputs/capacity_temporal_v1/2b.json"
      ],
      "argv": [
        "{python}",
        "experiments/temporal_order_controls.py",
        "preflight",
        "--config",
        "configs/temporal_controls_v1.json"
      ]
    },
    {
      "id": "E2_2b_repeat_vs_reversal_1600_GPU_inferences",
      "gpu": true,
      "min_free_mib": 12000,
      "timeout_seconds": 7200,
      "max_attempts": 1,
      "requires_files": [
        "models/SmolVLM2-2.2B-Instruct/model-00001-of-00002.safetensors",
        "models/SmolVLM2-2.2B-Instruct/model-00002-of-00002.safetensors"
      ],
      "argv": [
        "{python}",
        "experiments/temporal_order_controls.py",
        "infer",
        "--config",
        "configs/temporal_controls_v1.json"
      ]
    },
    {
      "id": "E3_paired_temporal_degradation_and_flip_report",
      "gpu": false,
      "timeout_seconds": 180,
      "max_attempts": 1,
      "requires_files": [
        "outputs/temporal_controls_v1/controlled_predictions.json"
      ],
      "argv": [
        "{python}",
        "experiments/temporal_order_controls.py",
        "report",
        "--config",
        "configs/temporal_controls_v1.json"
      ]
    },
    {
      "id": "E4_frozen_regression_tests",
      "gpu": false,
      "timeout_seconds": 300,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests"
      ]
    },
    {
      "id": "E5_source_security_gate",
      "gpu": false,
      "timeout_seconds": 120,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/source_security_guard.py"
      ]
    }
  ]
}
