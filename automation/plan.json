      ],
      "requires_files": [
        "outputs/davis_occlusion_v3/dev_selection.json",
        "outputs/davis_occlusion_v3/vlm_visibility_dev_gate.json"
      ]
    },
    {
      "id": "D11_TEST_GPU_SmolVLM2_binary_visibility_predictions",
      "gpu": true,
      "min_free_mib": 10000,
      "timeout_seconds": 3600,
      "max_attempts": 1,
      "argv": [
        "env",
        "MVVG_VLM_MODEL=../models/SmolVLM2-500M-Video-Instruct",
        "{python}",
        "experiments/davis_vlm_visibility.py",
        "predict-test",
        "--config",
        "configs/davis_occlusion_v3.json"
      ],
      "requires_files": [
        "outputs/davis_occlusion_v3/test_predictions.json.sha256",
        "outputs/davis_occlusion_v3/vlm_visibility_dev_gate.json",
        "../models/SmolVLM2-500M-Video-Instruct/model.safetensors"
      ]
    },
    {
      "id": "D12_first_only_TEST_CPU_future_mask_score",
      "gpu": false,
      "timeout_seconds": 1800,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/davis_occlusion_eval.py",
        "score-test",
        "--config",
        "configs/davis_occlusion_v3.json"
      ],
      "requires_files": [
        "outputs/davis_occlusion_v3/test_predictions.json.sha256",
        "outputs/davis_occlusion_v3/vlm_visibility_test_predictions.json.sha256"
      ]
    },
    {
      "id": "D13_first_only_TEST_VLM_visibility_score",
      "gpu": false,
      "timeout_seconds": 1800,
      "max_attempts": 1,
      "argv": [
        "env",
        "MVVG_VLM_MODEL=../models/SmolVLM2-500M-Video-Instruct",
        "{python}",
        "experiments/davis_vlm_visibility.py",
        "score-test",
        "--config",
        "configs/davis_occlusion_v3.json"
