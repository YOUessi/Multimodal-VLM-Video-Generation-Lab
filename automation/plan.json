        "{python}",
        "experiments/davis_occlusion_eval.py",
        "select-dev",
        "--config",
        "configs/davis_occlusion_v3.json"
      ],
      "requires_files": [
        "outputs/davis_occlusion_v3/dev_results.json"
      ]
    },
    {
      "id": "D09_predeclared_VLM_visibility_DEV_interface_gate",
      "gpu": false,
      "timeout_seconds": 600,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/davis_vlm_visibility.py",
        "dev-gate",
        "--config",
        "configs/davis_occlusion_v3.json"
      ],
      "requires_files": [
        "outputs/davis_occlusion_v3/vlm_visibility_dev_results.json"
      ]
