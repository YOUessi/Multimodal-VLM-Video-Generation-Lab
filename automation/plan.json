{
  "version": "2026-11-02-batch41-robotap-visibility-affine-v1",
  "enabled": true,
  "description": "Batch41 uses two official RoboTAP shards (synthetic robotics, CC BY 4.0), a hash-only 6 DEV / 14 TEST video split, first-visible point queries, CPU KLT/template/affine-stabilized baselines, SmolVLM2-500M visibility classification, immutable predictions, one-time TEST scoring, and final source/data audit. TEST labels may not drive any selection.",
  "stages": [
    {
      "id": "R00_install_optional_mediapy_pickle_dependency",
      "gpu": false,
      "timeout_seconds": 1200,
      "max_attempts": 1,
      "argv": [
        "env",
        "PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple",
        "{python}",
        "-m",
        "pip",
        "install",
        "mediapy>=1.2.7,<2"
      ]
    },
    {
      "id": "R01_range_extract_official_RoboTAP_shards",
      "gpu": false,
      "timeout_seconds": 10800,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/robotap_batch41_data.py",
        "download",
        "--config",
        "configs/robotap_batch41.json"
      ]
    },
    {
      "id": "R02_prepare_frozen_scene_disjoint_RoboTAP_manifest",
      "gpu": false,
      "timeout_seconds": 7200,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/robotap_batch41_data.py",
        "prepare",
        "--config",
        "configs/robotap_batch41.json"
      ],
      "requires_files": [
        "data/robotap_batch41/download_manifest.json",
        "data/robotap_batch41/robotap_split0.pkl",
        "data/robotap_batch41/robotap_split1.pkl"
      ]
    },
    {
      "id": "R03_public_manifest_frame_and_query_audit",
      "gpu": false,
      "timeout_seconds": 2400,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/robotap_batch41_data.py",
        "audit",
        "--config",
        "configs/robotap_batch41.json"
      ],
      "requires_files": [
        "data/robotap_batch41/batch41_frozen/manifest.json",
        "data/robotap_batch41/batch41_frozen/queries-public.json",
        "data/robotap_batch41/batch41_frozen/oracle-private.json"
      ]
    },
    {
      "id": "R04_full_project_regression_suite",
      "gpu": false,
      "timeout_seconds": 1800,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests"
      ],
      "requires_files": [
        "tests/test_robotap_batch41.py"
      ]
    },
    {
      "id": "R05_DEV_CPU_labelblind_point_tracking_predictions",
      "gpu": false,
      "timeout_seconds": 5400,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/robotap_batch41_eval.py",
        "predict-dev",
        "--config",
        "configs/robotap_batch41.json"
      ],
      "requires_files": [
        "data/robotap_batch41/batch41_frozen/manifest.json",
        "data/robotap_batch41/batch41_frozen/queries-public.json"
      ]
    },
    {
      "id": "R06_DEV_CPU_private_oracle_score",
      "gpu": false,
      "timeout_seconds": 1800,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/robotap_batch41_eval.py",
        "score-dev",
        "--config",
        "configs/robotap_batch41.json"
      ],
      "requires_files": [
        "outputs/robotap_batch41/dev_predictions.json.sha256"
      ]
    },
    {
      "id": "R07_select_tracking_method_from_DEV_only",
      "gpu": false,
      "timeout_seconds": 900,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/robotap_batch41_eval.py",
        "select-dev",
        "--config",
        "configs/robotap_batch41.json"
      ],
      "requires_files": [
        "outputs/robotap_batch41/dev_results.json"
      ]
    },
    {
      "id": "R08_DEV_GPU_SmolVLM2_visibility_predictions",
      "gpu": true,
      "timeout_seconds": 7200,
      "max_attempts": 1,
      "argv": [
        "env",
        "MVVG_VLM_MODEL=../models/SmolVLM2-500M-Video-Instruct",
        "{python}",
        "experiments/robotap_batch41_vlm.py",
        "predict-dev",
        "--config",
        "configs/robotap_batch41.json"
      ],
      "requires_files": [
        "../models/SmolVLM2-500M-Video-Instruct/model.safetensors",
        "data/robotap_batch41/batch41_frozen/queries-public.json"
      ],
      "min_free_mib": 10000
    },
    {
      "id": "R09_DEV_VLM_visibility_score",
      "gpu": false,
      "timeout_seconds": 1800,
      "max_attempts": 1,
      "argv": [
        "env",
        "MVVG_VLM_MODEL=../models/SmolVLM2-500M-Video-Instruct",
        "{python}",
        "experiments/robotap_batch41_vlm.py",
        "score-dev",
        "--config",
        "configs/robotap_batch41.json"
      ],
      "requires_files": [
        "outputs/robotap_batch41/vlm_visibility_dev_predictions.json.sha256"
      ]
    },
    {
      "id": "R10_predeclared_VLM_DEV_interface_gate",
      "gpu": false,
      "timeout_seconds": 900,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/robotap_batch41_vlm.py",
        "dev-gate",
        "--config",
        "configs/robotap_batch41.json"
      ],
      "requires_files": [
        "outputs/robotap_batch41/vlm_visibility_dev_results.json.sha256"
      ]
    },
    {
      "id": "R11_TEST_CPU_labelblind_point_tracking_predictions",
      "gpu": false,
      "timeout_seconds": 5400,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/robotap_batch41_eval.py",
        "predict-test",
        "--config",
        "configs/robotap_batch41.json"
      ],
      "requires_files": [
        "outputs/robotap_batch41/dev_selection.json.sha256"
      ]
    },
    {
      "id": "R12_TEST_GPU_SmolVLM2_visibility_predictions_or_gate_skip",
      "gpu": true,
      "timeout_seconds": 7200,
      "max_attempts": 1,
      "argv": [
        "env",
        "MVVG_VLM_MODEL=../models/SmolVLM2-500M-Video-Instruct",
        "{python}",
        "experiments/robotap_batch41_vlm.py",
        "predict-test",
        "--config",
        "configs/robotap_batch41.json"
      ],
      "requires_files": [
        "outputs/robotap_batch41/vlm_visibility_dev_gate.json.sha256",
        "outputs/robotap_batch41/test_predictions.json.sha256"
      ],
      "min_free_mib": 10000
    },
    {
      "id": "R13_first_only_TEST_CPU_private_oracle_score",
      "gpu": false,
      "timeout_seconds": 2400,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/robotap_batch41_eval.py",
        "score-test",
        "--config",
        "configs/robotap_batch41.json"
      ],
      "requires_files": [
        "outputs/robotap_batch41/test_predictions.json.sha256"
      ]
    },
    {
      "id": "R14_first_only_TEST_VLM_visibility_score",
      "gpu": false,
      "timeout_seconds": 2400,
      "max_attempts": 1,
      "argv": [
        "env",
        "MVVG_VLM_MODEL=../models/SmolVLM2-500M-Video-Instruct",
        "{python}",
        "experiments/robotap_batch41_vlm.py",
        "score-test",
        "--config",
        "configs/robotap_batch41.json"
      ],
      "requires_files": [
        "outputs/robotap_batch41/vlm_visibility_test_predictions.json.sha256"
      ]
    },
    {
      "id": "R15_source_media_weights_and_secrets_publication_guard",
      "gpu": false,
      "timeout_seconds": 1200,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/source_security_guard.py"
      ],
      "requires_files": [
        "outputs/robotap_batch41/test_results.json"
      ]
    },
    {
      "id": "R16_final_full_project_regression_suite",
      "gpu": false,
      "timeout_seconds": 1800,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests"
      ],
      "requires_files": [
        "outputs/robotap_batch41/test_results.json",
        "outputs/robotap_batch41/vlm_visibility_test_results.json"
      ]
    },
    {
      "id": "R17_generate_Batch41_results_report",
      "gpu": false,
      "timeout_seconds": 900,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/robotap_batch41_eval.py",
        "report",
        "--config",
        "configs/robotap_batch41.json"
      ],
      "requires_files": [
        "outputs/robotap_batch41/dev_selection.json",
        "outputs/robotap_batch41/test_results.json",
        "outputs/robotap_batch41/vlm_visibility_test_results.json"
      ]
    },
    {
      "id": "R18_final_data_prediction_and_source_SHA_audit",
      "gpu": false,
      "timeout_seconds": 1800,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/robotap_batch41_eval.py",
        "final-audit",
        "--config",
        "configs/robotap_batch41.json"
      ],
      "requires_files": [
        "outputs/robotap_batch41/BATCH41_RESULTS.md"
      ]
    }
  ]
}
