{
  "version": "2026-11-02-batch-37-real-davis-long-horizon-v1",
  "enabled": true,
  "description": "Pre-TEST fixed all method thresholds; fresh DAVIS scene-disjoint real-camera clips, 16 frames x12; no historical test tuning; label-blind predictions hash pinned, CPU only; absent-object and shrink proxy metrics; no media/weights/secrets on GitHub.",
  "stages": [
    {
