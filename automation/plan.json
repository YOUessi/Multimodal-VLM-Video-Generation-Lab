{
  "version": "2026-10-31-batch-11",
  "enabled": true,
  "description": "Cost-only shared cached scenelet visual signals for identical 3/5-frame STAR decisions; SHA-identified video cache, full pixel-identical pre/post verification, cold/warm latency and 3 repeat trials. No test label tuning.",
  "stages": [
    {
      "id": "B52_shared_cache_unit_and_integrity_tests",
      "gpu": false,
      "timeout_seconds": 240,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests/test_shared_temporal_cache.py"
      ]
    },
    {
      "id": "B53_shared_40_video_cold_warm_cache_benchmark",
      "gpu": false,
      "timeout_seconds": 900,
      "max_attempts": 1,
      "requires_files": [
        "outputs/adaptive_sampling_v2/sampling_plan.json",
        "outputs/star_sft_round2/manifest.json"
      ],
      "argv": [
        "{python}",
        "experiments/shared_temporal_cache.py",
        "--config",
        "configs/shared_cache_v1.json"
      ]
    },
    {
      "id": "B54_full_engineering_regression_tests",
      "gpu": false,
      "timeout_seconds": 240,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests"
      ]
    }
  ]
}
