      "argv": [
        "env",
        "MVVG_VLM_MODEL=../models/SmolVLM2-500M-Video-Instruct",
        "{python}",
        "experiments/robotap_batch41_vlm.py",
        "score-test",
        "--config",
        "configs/robotap_batch41e.json"
      ],
      "requires_files": [
        "outputs/robotap_batch41e_grouped/vlm_visibility_test_predictions.json.sha256"
      ]
    },
    {
      "id": "R13_source_media_weights_and_secrets_publication_guard",
      "gpu": false,
      "timeout_seconds": 1200,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/source_security_guard.py"
      ],
      "requires_files": [
        "outputs/robotap_batch41e_grouped/test_results.json"
      ]
    },
    {
      "id": "R14_final_full_project_regression_suite",
      "gpu": false,
      "timeout_seconds": 2400,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests"
      ],
      "requires_files": [
        "outputs/robotap_batch41e_grouped/test_results.json",
        "outputs/robotap_batch41e_grouped/vlm_visibility_test_results.json"
      ]
    },
    {
      "id": "R15_generate_Batch41E_results_report",
      "gpu": false,
      "timeout_seconds": 900,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/robotap_batch41_eval.py",
        "report",
        "--config",
        "configs/robotap_batch41e.json"
      ],
      "requires_files": [
        "outputs/robotap_batch41e_grouped/dev_selection.json",
        "outputs/robotap_batch41e_grouped/test_results.json",
        "outputs/robotap_batch41e_grouped/vlm_visibility_test_results.json"
      ]
    },
    {
      "id": "R16_final_episode_data_prediction_and_source_SHA_audit",
      "gpu": false,
      "timeout_seconds": 1800,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/robotap_batch41_eval.py",
        "final-audit",
        "--config",
