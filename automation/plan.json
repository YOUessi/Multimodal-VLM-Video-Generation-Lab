{
  "version": "2026-11-01-batch-24",
  "enabled": true,
  "description": "New counterfactual question-grounded object-motion study: frozen 20 dev and 120 test scene pairs, each original/reverse; 5 balanced motion classes with distractors. Pixel-only color tracker, classical CV baseline, 500M and 2.2B VLM matched text-only/RGB/number trajectory/conflicting-order controls. No tuning to test; cluster bootstrap per independent scene pair; raw source and model weights remain local.",
  "stages": [
    {
      "id": "G1_generate_280_counterfactual_video_pairs",
      "gpu": false,
      "timeout_seconds": 500,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/object_motion_counterfactual_data.py",
        "--config",
        "configs/object_motion_v1.json"
      ]
    },
    {
      "id": "G2_dev_only_query_grounded_tracker_sanity",
      "gpu": false,
      "timeout_seconds": 300,
      "max_attempts": 1,
      "requires_files": [
        "data/object_motion_counterfactual_v1/manifest.json"
      ],
      "argv": [
        "{python}",
        "experiments/target_motion_tracking.py",
        "--config",
        "configs/object_motion_v1.json"
      ]
    },
    {
      "id": "G3_validate_all_source_video_hashes_and_opposite_pairs",
      "gpu": false,
      "timeout_seconds": 450,
      "max_attempts": 1,
      "requires_files": [
        "data/object_motion_counterfactual_v1/manifest.json"
      ],
      "argv": [
        "{python}",
        "experiments/object_motion_counterfactual_eval.py",
        "audit",
        "--config",
        "configs/object_motion_v1.json"
      ]
    },
    {
      "id": "G4_2_model_5_condition_dev_execution_smoke",
      "gpu": true,
      "min_free_mib": 12000,
      "timeout_seconds": 900,
      "max_attempts": 1,
      "requires_files": [
        "models/SmolVLM2-2.2B-Instruct/model-00001-of-00002.safetensors",
        "models/SmolVLM2-2.2B-Instruct/model-00002-of-00002.safetensors"
      ],
      "argv": [
        "{python}",
        "experiments/object_motion_counterfactual_eval.py",
        "preflight",
        "--config",
        "configs/object_motion_v1.json"
      ]
    },
    {
      "id": "G5_500M_five_condition_1200_real_GPU_inferences",
      "gpu": true,
      "min_free_mib": 11000,
      "timeout_seconds": 3600,
      "max_attempts": 1,
      "requires_files": [
        "data/object_motion_counterfactual_v1/manifest.json"
      ],
      "argv": [
        "{python}",
        "experiments/object_motion_counterfactual_eval.py",
        "evaluate",
        "--model",
        "500m",
        "--config",
        "configs/object_motion_v1.json"
      ]
    },
    {
      "id": "G6_2B_five_condition_1200_real_GPU_inferences",
      "gpu": true,
      "min_free_mib": 12000,
      "timeout_seconds": 3600,
      "max_attempts": 1,
      "requires_files": [
        "outputs/object_motion_counterfactual_v1/500m.json",
        "models/SmolVLM2-2.2B-Instruct/model-00001-of-00002.safetensors",
        "models/SmolVLM2-2.2B-Instruct/model-00002-of-00002.safetensors"
      ],
      "argv": [
        "{python}",
        "experiments/object_motion_counterfactual_eval.py",
        "evaluate",
        "--model",
        "2b",
        "--config",
        "configs/object_motion_v1.json"
      ]
    },
    {
      "id": "G7_clustered_paired_counterfactual_report_with_CV_baseline",
      "gpu": false,
      "timeout_seconds": 600,
      "max_attempts": 1,
      "requires_files": [
        "outputs/object_motion_counterfactual_v1/500m.json",
        "outputs/object_motion_counterfactual_v1/2b.json"
      ],
      "argv": [
        "{python}",
        "experiments/object_motion_counterfactual_eval.py",
        "report",
        "--config",
        "configs/object_motion_v1.json"
      ]
    },
    {
      "id": "G8_full_source_regression_tests",
      "gpu": false,
      "timeout_seconds": 300,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests"
      ]
    },
    {
      "id": "G9_no_models_video_media_committed_security",
      "gpu": false,
      "timeout_seconds": 120,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/source_security_guard.py"
      ]
    }
  ]
}
