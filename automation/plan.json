{
  "version": "2026-10-31-batch-12",
  "enabled": true,
  "description": "CRITICAL data-leakage remediation: full MP4 SHA256 groups, 193 contents, no cross-split duplicates; 120/40/40 fresh real VLM LoRA across seeds, validation-only choice, new heldout test, fail-closed reporting and tests.",
  "stages": [
    {
      "id": "B55_content_SHA_grouped_split_and_200_video_preflight",
      "gpu": false,
      "timeout_seconds": 1500,
      "max_attempts": 1,
      "requires_files": [
        "data/mvbench_star/provenance.json",
        "data/mvbench_star/text/action_sequence.json",
        "models/SmolVLM2-500M-Video-Instruct/model.safetensors"
      ],
      "argv": [
        "{python}",
        "experiments/star_content_grouped_sft.py",
        "prepare",
        "--config",
        "configs/star_grouped_sft_v1.json"
      ]
    },
    {
      "id": "B56_fresh_content_disjoint_two_seed_real_SFT",
      "gpu": true,
      "min_free_mib": 11000,
      "timeout_seconds": 3600,
      "max_attempts": 1,
      "requires_files": [
        "outputs/star_grouped_sft_v1/manifest.json"
      ],
      "argv": [
        "{python}",
        "experiments/star_content_grouped_sft.py",
        "train",
        "--config",
        "configs/star_grouped_sft_v1.json"
      ]
    },
    {
      "id": "B57_validation_only_select_seed",
      "gpu": true,
      "min_free_mib": 11000,
      "timeout_seconds": 1800,
      "max_attempts": 1,
      "requires_files": [
        "outputs/star_grouped_sft_v1/adapter_19/adapter_model.safetensors",
        "outputs/star_grouped_sft_v1/adapter_37/adapter_model.safetensors"
      ],
      "argv": [
        "{python}",
        "experiments/star_content_grouped_sft.py",
        "validate",
        "--config",
        "configs/star_grouped_sft_v1.json"
      ]
    },
    {
      "id": "B58_content_disjoint_heldout_test_once",
      "gpu": true,
      "min_free_mib": 11000,
      "timeout_seconds": 2100,
      "max_attempts": 1,
      "requires_files": [
        "outputs/star_grouped_sft_v1/chosen_seed.json"
      ],
      "argv": [
        "{python}",
        "experiments/star_content_grouped_sft.py",
        "test",
        "--config",
        "configs/star_grouped_sft_v1.json"
      ]
    },
    {
      "id": "B59_SHA_grouped_authoritative_final_report",
      "gpu": false,
      "timeout_seconds": 180,
      "max_attempts": 1,
      "requires_files": [
        "outputs/star_grouped_sft_v1/test_comparison.json"
      ],
      "argv": [
        "{python}",
        "experiments/star_grouped_report.py",
        "--run-dir",
        "outputs/star_grouped_sft_v1"
      ]
    },
    {
      "id": "B60_frozen_source_tests",
      "gpu": false,
      "timeout_seconds": 240,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests"
      ]
    }
  ]
}
