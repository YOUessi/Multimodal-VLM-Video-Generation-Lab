        "experiments/robotap_batch41_eval.py",
        "score-dev",
        "--config",
        "configs/robotap_batch41e.json"
      ],
      "requires_files": [
        "outputs/robotap_batch41e_grouped/dev_predictions.json.sha256"
      ]
    },
    {
      "id": "R05_select_tracking_method_from_DEV_only",
      "gpu": false,
      "timeout_seconds": 900,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/robotap_batch41_eval.py",
        "select-dev",
        "--config",
        "configs/robotap_batch41e.json"
      ],
      "requires_files": [
        "outputs/robotap_batch41e_grouped/dev_results.json"
      ]
    },
    {
