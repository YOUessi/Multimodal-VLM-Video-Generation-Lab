{
  "version": "batch46-fresh-kinetics-cross-batch-class-disjoint-preregistered-transfer-20261102-v1",
  "enabled": true,
  "description": "Twelve new natural Kinetics videos across twelve classes disjoint from Batch42 and Batch45E; replicate the old DEV-selected affine tracker with no new method tuning. Strict TEST prediction freeze, CPU and VLM admission gates and private-media embargo.",
  "source_of_truth": "GitHub main; runner freezes clean checkout SHA in .automation/state.json. Raw videos, shards, frames, private point tracks, predictions and model weights remain local on Tang.",
  "failure_policy": "Single attempt per frozen stage; fail closed. Preserve failed logs and partial downloads. Any repair requires a new GitHub source SHA and a new repo-batch*-tested directory. Never tune on TEST.",
  "test_policy": "Fix tracker at Batch45E DEV SHA-pinned choice; Batch46 DEV descriptive only; both TEST prediction files must be SHA-pinned before either TEST score opens private labels.",
  "gpu_policy": "VLM inference stages use /tmp/tang_shared_gpu_experiments.lock; require no other CUDA compute process and at least 11,000 MiB free. CPU stages explicitly disable OpenCV OpenCL.",
  "data_policy": "Reuse only Kinetics metadata and URL list. Download new class shards to a new batch46 private directory; all old data and failure logs immutable. Do not publish media/weights/private labels.",
