{
  "version": "2026-11-01-batch-30",
  "enabled": true,
  "description": "Generic named HSV+component-association tracker, no calibration from CLEVRER labels, 40/40 synthetic dev preflight, full 200 public CLEVRER moving-direction source videos, conservative high-delta gate, preserved frozen 500M/2.2B baseline predictions. All errors/abstentions included; exploratory domain transfer only.",
  "stages": [
    {
      "id": "M1_generic_HSV_dev_only_40_video_sanity",
