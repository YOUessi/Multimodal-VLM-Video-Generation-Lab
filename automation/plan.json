      ]
    },
    {
      "id": "D14_source_media_weights_and_secrets_publication_guard",
      "gpu": false,
      "timeout_seconds": 900,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/source_security_guard.py"
      ],
      "requires_files": [
        "outputs/davis_occlusion_v3/vlm_visibility_test_results.json"
      ]
    },
    {
      "id": "D15_final_full_regression_suite",
      "gpu": false,
      "timeout_seconds": 1200,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests"
      ],
      "requires_files": [
        "outputs/davis_occlusion_v3/test_results.json",
        "outputs/davis_occlusion_v3/vlm_visibility_test_results.json"
      ]
    },
    {
      "id": "D16_generate_sealed_Batch40_results_report",
      "gpu": false,
      "timeout_seconds": 600,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/davis_batch40_report.py",
        "report",
        "--config",
        "configs/davis_occlusion_v3.json"
      ],
      "requires_files": [
        "outputs/davis_occlusion_v3/dev_selection.json",
        "outputs/davis_occlusion_v3/test_results.json",
        "outputs/davis_occlusion_v3/vlm_visibility_test_results.json"
      ]
    },
    {
      "id": "D17_final_data_prediction_and_source_SHA_audit",
      "gpu": false,
      "timeout_seconds": 900,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/davis_batch40_report.py",
        "final-audit",
        "--config",
        "configs/davis_occlusion_v3.json"
      ],
      "requires_files": [
        "outputs/davis_occlusion_v3/BATCH40_RESULTS.md"
      ]
    }
  ]
}
