{
  "version": "2026-11-01-batch-19",
  "enabled": true,
  "description": "Frozen independent public MVBench 400 videos across CLEVRER moving_direction and natural scene_transition. Compare SmolVLM2-500M vs 2.2B under 0 (text-only), 3 and 5 uniform decoded frames, no finetuning or test-driven prompt tuning. Real GPU inference, per-item audit, paired bootstrap CIs, failure stop.",
  "stages": [
    {
      "id": "B89_frozen_external_400_video_source_and_decode_preflight",
      "gpu": false,
      "timeout_seconds": 1500,
      "max_attempts": 1,
      "requires_files": [
        "data/mvbench_moving_direction/provenance.json",
        "data/mvbench_scene_transition/provenance.json",
        "outputs/star_perceptual_grouped_sft_v1/manifest.json"
      ],
      "argv": [
        "{python}",
        "experiments/mvbench_capacity_temporal.py",
        "prepare",
        "--config",
        "configs/capacity_temporal_v1.json"
      ]
    },
    {
      "id": "B90_smol500m_protocol_and_text_image_smoke",
      "gpu": true,
      "min_free_mib": 10000,
      "timeout_seconds": 900,
      "max_attempts": 1,
      "requires_files": [
        "models/SmolVLM2-500M-Video-Instruct/model.safetensors"
      ],
      "argv": [
        "{python}",
        "experiments/mvbench_capacity_temporal.py",
        "preflight",
        "--model",
        "500m",
        "--config",
        "configs/capacity_temporal_v1.json"
      ]
    },
    {
      "id": "B91_smol500m_400x3_real_public_QA_baseline",
      "gpu": true,
      "min_free_mib": 10000,
      "timeout_seconds": 4500,
      "max_attempts": 1,
      "requires_files": [
        "outputs/capacity_temporal_v1/manifest.json"
      ],
      "argv": [
        "{python}",
        "experiments/mvbench_capacity_temporal.py",
        "evaluate",
        "--model",
        "500m",
        "--config",
        "configs/capacity_temporal_v1.json"
      ]
    },
    {
      "id": "B92_smol2b_protocol_and_VRAM_preflight",
      "gpu": true,
      "min_free_mib": 12000,
      "timeout_seconds": 1200,
      "max_attempts": 1,
      "requires_files": [
        "models/SmolVLM2-2.2B-Instruct/model-00001-of-00002.safetensors",
        "models/SmolVLM2-2.2B-Instruct/model-00002-of-00002.safetensors"
      ],
      "argv": [
        "{python}",
        "experiments/mvbench_capacity_temporal.py",
        "preflight",
        "--model",
        "2b",
        "--config",
        "configs/capacity_temporal_v1.json"
      ]
    },
    {
      "id": "B93_smol2b_400x3_real_public_QA_comparison",
      "gpu": true,
      "min_free_mib": 12000,
      "timeout_seconds": 7200,
      "max_attempts": 1,
      "requires_files": [
        "models/SmolVLM2-2.2B-Instruct/model-00001-of-00002.safetensors",
        "models/SmolVLM2-2.2B-Instruct/model-00002-of-00002.safetensors",
        "outputs/capacity_temporal_v1/500m.json"
      ],
      "argv": [
        "{python}",
        "experiments/mvbench_capacity_temporal.py",
        "evaluate",
        "--model",
        "2b",
        "--config",
        "configs/capacity_temporal_v1.json"
      ]
    },
    {
      "id": "B94_full_paired_temporal_and_capacity_report",
      "gpu": false,
      "timeout_seconds": 300,
      "max_attempts": 1,
      "requires_files": [
        "outputs/capacity_temporal_v1/500m.json",
        "outputs/capacity_temporal_v1/2b.json"
      ],
      "argv": [
        "{python}",
        "experiments/mvbench_capacity_temporal.py",
        "compare",
        "--config",
        "configs/capacity_temporal_v1.json"
      ]
    },
    {
      "id": "B95_regression_tests_with_video_contract",
      "gpu": false,
      "timeout_seconds": 300,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests"
      ]
    },
    {
      "id": "B96_publication_security_guard",
      "gpu": false,
      "timeout_seconds": 120,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/source_security_guard.py"
      ]
    }
  ]
}
