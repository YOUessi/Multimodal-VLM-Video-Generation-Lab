{
  "version": "2026-11-02-batch41e-robotap-query-path-repair-v1",
  "enabled": true,
  "description": "Batch41E repairs the configured RoboTAP frozen-subdirectory query lookup, adds a decoy-path regression, isolates all outputs, reuses only the untouched episode-disjoint Batch41B freeze after Batch41D stopped before DEV scoring and before any TEST read, then performs DEV-only CPU selection, a DEV-gated SmolVLM2-500M visibility baseline, pinned TEST predictions, first-only TEST scoring, security checks, and final hash audits. RoboTAP is synthetic robotics video, not natural camera footage.",
  "stages": [
    {
      "id": "R00_verify_RoboTAP_source_shards_and_frozen_manifest",
      "gpu": false,
      "timeout_seconds": 3600,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/robotap_batch41_data.py",
        "final-audit",
        "--config",
        "configs/robotap_batch41e.json"
      ],
      "requires_files": [
        "data/robotap_batch41/download_manifest.json",
        "data/robotap_batch41/robotap_split0.pkl",
        "data/robotap_batch41/robotap_split1.pkl",
        "data/robotap_batch41/batch41_grouped_frozen/manifest.json",
        "data/robotap_batch41/batch41_grouped_frozen/queries-public.json",
        "data/robotap_batch41/batch41_grouped_frozen/oracle-private.json"
      ]
    },
    {
      "id": "R01_targeted_RoboTAP_query_path_regression",
      "gpu": false,
      "timeout_seconds": 1800,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests/test_robotap_batch41.py"
      ],
      "requires_files": [
        "tests/test_robotap_batch41.py"
      ]
    },
    {
      "id": "R02_full_project_regression_suite",
      "gpu": false,
      "timeout_seconds": 2400,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests"
      ],
      "requires_files": [
        "tests/test_robotap_batch41.py"
      ]
    },
    {
      "id": "R03_DEV_CPU_labelblind_predictions",
      "gpu": false,
      "timeout_seconds": 5400,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "experiments/robotap_batch41_eval.py",
        "predict-dev",
        "--config",
        "configs/robotap_batch41e.json"
      ],
      "requires_files": [
        "data/robotap_batch41/batch41_grouped_frozen/manifest.json",
        "data/robotap_batch41/batch41_grouped_frozen/queries-public.json"
      ]
    },
    {
      "id": "R04_DEV_CPU_private_oracle_score",
      "gpu": false,
      "timeout_seconds": 1800,
      "max_attempts": 1,
      "argv": [
