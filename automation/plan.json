{
  "version": "2026-10-31-batch-4",
  "enabled": true,
  "description": "120 untouched MVBench real-video option position rotation; base and synthetic LoRA; preregistered ensemble, corrected final report and offline CI",
  "stages": [
    {
      "id": "B13_unseen120_base_option_rotation",
      "gpu": true,
      "min_free_mib": 11000,
      "timeout_seconds": 2400,
      "max_attempts": 1,
      "requires_files": [
        "outputs/mvbench_round1/manifest.json",
        "data/mvbench_public/text/action_antonym.json",
        "models/SmolVLM2-500M-Video-Instruct/model.safetensors"
      ],
      "argv": [
        "{python}",
        "experiments/choice_bias_eval.py",
        "base",
        "--config",
        "configs/choice_bias_round1.json"
      ]
    },
    {
      "id": "B14_unseen120_synthetic_lora_option_rotation",
      "gpu": true,
      "min_free_mib": 11000,
      "timeout_seconds": 2400,
      "max_attempts": 1,
      "requires_files": [
        "outputs/choice_bias_round1/base.json",
        "outputs/temporal_round2/adapter/adapter_model.safetensors"
      ],
      "argv": [
        "{python}",
        "experiments/choice_bias_eval.py",
        "synthetic_lora",
        "--config",
        "configs/choice_bias_round1.json"
      ]
    },
    {
      "id": "B15_paired_order_bias_analysis",
      "gpu": false,
      "timeout_seconds": 240,
      "max_attempts": 1,
      "requires_files": [
        "outputs/choice_bias_round1/base.json",
        "outputs/choice_bias_round1/synthetic_lora.json"
      ],
      "argv": [
        "{python}",
        "experiments/choice_bias_eval.py",
        "compare",
        "--config",
        "configs/choice_bias_round1.json"
      ]
    },
    {
      "id": "B16_corrected_project_release_report",
      "gpu": false,
      "timeout_seconds": 240,
      "max_attempts": 1,
      "requires_files": [
        "outputs/choice_bias_round1/comparison.json",
        "outputs/mvbench_round1/rescored_v2/comparison_scored.json",
        "outputs/multi_seed/REPLICATION.json"
      ],
      "argv": [
        "{python}",
        "experiments/release_report_v2.py",
        "build"
      ]
    },
    {
      "id": "B17_frozen_release_tests",
      "gpu": false,
      "timeout_seconds": 240,
      "max_attempts": 1,
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests"
      ]
    }
  ]
}
